{"client": "qwen2.5:3b", "completed": true, "droppedTurnCount": 0, "durationMilliseconds": 15527.0, "errorMessage": null, "foldedTurnCount": 0, "kind": "scenario", "runID": "d95206c3877f", "scenarioID": "sc01_self_intro", "startedAt": "2026-10-26T15:15:10.950057+00:00", "topic": "자기소개", "turns": [{"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 222, "foldedTurnCount": 0, "index": 0, "inputTokens": 222, "modelMilliseconds": 14582.9, "outputTokens": 15, "promptTurnCount": 4, "reply": "Oh, really? That's cool. Where do you live now?", "userText": "Hello. My name is Jina. I am from Korea."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 256, "foldedTurnCount": 0, "index": 1, "inputTokens": 256, "modelMilliseconds": 363.3, "outputTokens": 16, "promptTurnCount": 6, "reply": "That's great. What do you like to do in your free time?", "userText": "I am work at a small company in Seoul."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 290, "foldedTurnCount": 0, "index": 2, "inputTokens": 290, "modelMilliseconds": 292.9, "outputTokens": 13, "promptTurnCount": 8, "reply": "That sounds fun. What kind of music do you like?", "userText": "I like listen to music and watch movies."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 323, "foldedTurnCount": 0, "index": 3, "inputTokens": 323, "modelMilliseconds": 287.6, "outputTokens": 13, "promptTurnCount": 10, "reply": "That's good to hear. Do you find it helpful?", "userText": "Yes, I study English every day for my job."}]}
{"client": "qwen2.5:3b", "completed": true, "droppedTurnCount": 0, "durationMilliseconds": 1861.4, "errorMessage": null, "foldedTurnCount": 0, "kind": "scenario", "runID": "6b95df7bf3f9", "scenarioID": "sc02_cafe_order", "startedAt": "2026-10-26T15:15:26.477562+00:00", "topic": "카페에서 주문하기", "turns": [{"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 213, "foldedTurnCount": 0, "index": 0, "inputTokens": 213, "modelMilliseconds": 365.4, "outputTokens": 17, "promptTurnCount": 4, "reply": "Great choice! Do you prefer almond milk or regular milk in your latte?", "userText": "I want a large iced latte, please."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 247, "foldedTurnCount": 0, "index": 1, "inputTokens": 247, "modelMilliseconds": 456.9, "outputTokens": 22, "promptTurnCount": 6, "reply": "Sure thing! How much less sugar do you want? Or would you like it to be just sweet?", "userText": "Can I get it with less sugar?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 283, "foldedTurnCount": 0, "index": 2, "inputTokens": 283, "modelMilliseconds": 582.7, "outputTokens": 29, "promptTurnCount": 8, "reply": "It's a bit hard for me to say without the shop being here. Do you know the price, or would you like to check?", "userText": "How much is it?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 328, "foldedTurnCount": 0, "index": 3, "inputTokens": 328, "modelMilliseconds": 456.4, "outputTokens": 20, "promptTurnCount": 10, "reply": "Perfect! Would you like to pay by card now, or do you need help with that?", "userText": "Okay. I pay by card."}]}
{"client": "qwen2.5:3b", "completed": true, "droppedTurnCount": 0, "durationMilliseconds": 1474.1, "errorMessage": null, "foldedTurnCount": 0, "kind": "scenario", "runID": "e93e3573ba60", "scenarioID": "sc03_restaurant_order", "startedAt": "2026-10-26T15:15:28.339086+00:00", "topic": "식당에서 주문하기", "turns": [{"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 211, "foldedTurnCount": 0, "index": 0, "inputTokens": 211, "modelMilliseconds": 369.6, "outputTokens": 17, "promptTurnCount": 4, "reply": "Great choice! They have a few sauces, which one do you like best?", "userText": "Yes, I want the chicken pasta please."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 242, "foldedTurnCount": 0, "index": 1, "inputTokens": 242, "modelMilliseconds": 426.0, "outputTokens": 20, "promptTurnCount": 6, "reply": "Not spicy at all! They usually have mild sauce. Would you like any sides with it?", "userText": "Is it very spicy?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 283, "foldedTurnCount": 0, "index": 2, "inputTokens": 283, "modelMilliseconds": 307.5, "outputTokens": 14, "promptTurnCount": 8, "reply": "Perfect! Your cola will be ready soon. Enjoy your meal!", "userText": "Then I will take it. And one cola, please."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 315, "foldedTurnCount": 0, "index": 3, "inputTokens": 315, "modelMilliseconds": 370.9, "outputTokens": 17, "promptTurnCount": 10, "reply": "You're welcome! Have a nice meal! How was your day so far?", "userText": "No, that's all. Thank you."}]}
{"client": "qwen2.5:3b", "completed": true, "droppedTurnCount": 0, "durationMilliseconds": 1585.7, "errorMessage": null, "foldedTurnCount": 0, "kind": "scenario", "runID": "7c6eb36173e6", "scenarioID": "sc04_directions", "startedAt": "2026-10-26T15:15:29.813292+00:00", "topic": "길 묻기", "turns": [{"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 211, "foldedTurnCount": 0, "index": 0, "inputTokens": 211, "modelMilliseconds": 414.7, "outputTokens": 20, "promptTurnCount": 4, "reply": "Oh, the train station is usually in the city center. Is that where you're heading?", "userText": "Yes, I look for the train station."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 248, "foldedTurnCount": 0, "index": 1, "inputTokens": 248, "modelMilliseconds": 528.5, "outputTokens": 24, "promptTurnCount": 6, "reply": "It can take a while, about 15 to 20 minutes. Do you have time to walk?", "userText": "How long does it take on foot?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 290, "foldedTurnCount": 0, "index": 2, "inputTokens": 290, "modelMilliseconds": 383.5, "outputTokens": 17, "promptTurnCount": 8, "reply": "There might be a bus nearby. Would you like to take a bus instead?", "userText": "Is there a bus? I am tired."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 326, "foldedTurnCount": 0, "index": 3, "inputTokens": 326, "modelMilliseconds": 258.9, "outputTokens": 11, "promptTurnCount": 10, "reply": "You're welcome! Have a nice day yourself!", "userText": "Thank you very much. Have a nice day."}]}
{"client": "qwen2.5:3b", "completed": true, "droppedTurnCount": 0, "durationMilliseconds": 1574.2, "errorMessage": null, "foldedTurnCount": 0, "kind": "scenario", "runID": "997164802dcd", "scenarioID": "sc05_making_appointment", "startedAt": "2026-10-26T15:15:31.399160+00:00", "topic": "약속 잡기", "turns": [{"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 214, "foldedTurnCount": 0, "index": 0, "inputTokens": 214, "modelMilliseconds": 301.4, "outputTokens": 13, "promptTurnCount": 4, "reply": "That's great! When would you like to come in?", "userText": "Hi, I want to make an appointment."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 243, "foldedTurnCount": 0, "index": 1, "inputTokens": 243, "modelMilliseconds": 446.7, "outputTokens": 20, "promptTurnCount": 6, "reply": "Perfect! We have a slot available at 3:00 PM. Is that okay?", "userText": "Friday afternoon is good for me."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 284, "foldedTurnCount": 0, "index": 2, "inputTokens": 284, "modelMilliseconds": 389.8, "outputTokens": 18, "promptTurnCount": 8, "reply": "Sure, you can come at 3:00 PM. Will that work?", "userText": "Can I come at three? I finish work at two."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 337, "foldedTurnCount": 0, "index": 3, "inputTokens": 337, "modelMilliseconds": 436.2, "outputTokens": 20, "promptTurnCount": 10, "reply": "That's good to know. Thanks for sharing. Is there anything else you need help with?", "userText": "My name is Jina Kim. My phone number is 010-1234-5678."}]}
{"client": "qwen2.5:3b", "completed": true, "droppedTurnCount": 0, "durationMilliseconds": 1450.7, "errorMessage": null, "foldedTurnCount": 0, "kind": "scenario", "runID": "88dcaa666eb1", "scenarioID": "sc06_hobbies", "startedAt": "2026-10-26T15:15:32.973506+00:00", "topic": "취미", "turns": [{"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 214, "foldedTurnCount": 0, "index": 0, "inputTokens": 214, "modelMilliseconds": 372.9, "outputTokens": 16, "promptTurnCount": 4, "reply": "That sounds nice! What kind of plants do you see on your hikes?", "userText": "I like hiking in the mountain near my home."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 252, "foldedTurnCount": 0, "index": 1, "inputTokens": 252, "modelMilliseconds": 339.9, "outputTokens": 14, "promptTurnCount": 6, "reply": "That's great! Did you see any special flowers or trees?", "userText": "Last weekend I go to Bukhansan with my friend."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 285, "foldedTurnCount": 0, "index": 2, "inputTokens": 285, "modelMilliseconds": 315.3, "outputTokens": 13, "promptTurnCount": 8, "reply": "Wow, amazing! What did you see from the top?", "userText": "It was very hard but the view was amazing."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 314, "foldedTurnCount": 0, "index": 3, "inputTokens": 314, "modelMilliseconds": 422.6, "outputTokens": 18, "promptTurnCount": 10, "reply": "On weekends, I like to watch TV or read a book. What about you?", "userText": "What do you do on weekends?"}]}
{"client": "qwen2.5:3b", "completed": true, "droppedTurnCount": 0, "durationMilliseconds": 1359.8, "errorMessage": null, "foldedTurnCount": 0, "kind": "scenario", "runID": "1f2032925365", "scenarioID": "sc07_weather_weekend", "startedAt": "2026-10-26T15:15:34.424248+00:00", "topic": "날씨와 주말", "turns": [{"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 215, "foldedTurnCount": 0, "index": 0, "inputTokens": 215, "modelMilliseconds": 326.1, "outputTokens": 14, "promptTurnCount": 4, "reply": "That sounds nice. What do you like to do at home?", "userText": "Not yet. Maybe I stay home and rest."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 246, "foldedTurnCount": 0, "index": 1, "inputTokens": 246, "modelMilliseconds": 402.2, "outputTokens": 18, "promptTurnCount": 6, "reply": "Saturday is usually nice, but I'm not sure. What's the date today?", "userText": "What is the weather like on Saturday?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 285, "foldedTurnCount": 0, "index": 2, "inputTokens": 285, "modelMilliseconds": 305.3, "outputTokens": 13, "promptTurnCount": 8, "reply": "That's a good choice. What movies do you like?", "userText": "Rainy? Then I will watch a movie at home."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 318, "foldedTurnCount": 0, "index": 3, "inputTokens": 318, "modelMilliseconds": 326.2, "outputTokens": 14, "promptTurnCount": 10, "reply": "That would be great! What kind of popcorn do you like?", "userText": "Do you want to come? I can make popcorn."}]}
{"client": "qwen2.5:3b", "completed": true, "droppedTurnCount": 0, "durationMilliseconds": 1435.3, "errorMessage": null, "foldedTurnCount": 0, "kind": "scenario", "runID": "6a1a1da78343", "scenarioID": "sc08_shopping", "startedAt": "2026-10-26T15:15:35.784193+00:00", "topic": "옷 쇼핑", "turns": [{"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 210, "foldedTurnCount": 0, "index": 0, "inputTokens": 210, "modelMilliseconds": 312.0, "outputTokens": 13, "promptTurnCount": 4, "reply": "That sounds good! What kind of jacket do you like?", "userText": "Yes, I am looking for a winter jacket."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 241, "foldedTurnCount": 0, "index": 1, "inputTokens": 241, "modelMilliseconds": 360.8, "outputTokens": 15, "promptTurnCount": 6, "reply": "I'm not sure about that. Do you prefer a smaller size?", "userText": "Do you have this in a smaller size?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 274, "foldedTurnCount": 0, "index": 2, "inputTokens": 274, "modelMilliseconds": 390.8, "outputTokens": 17, "promptTurnCount": 8, "reply": "It seems expensive. Have you checked if they have it in a smaller size?", "userText": "How much is it? It looks expensive."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 306, "foldedTurnCount": 0, "index": 3, "inputTokens": 306, "modelMilliseconds": 371.6, "outputTokens": 16, "promptTurnCount": 10, "reply": "Sure thing! Can you try it on and see if you like it?", "userText": "Can I try it on?"}]}
{"client": "qwen2.5:3b", "completed": true, "droppedTurnCount": 0, "durationMilliseconds": 1317.9, "errorMessage": null, "foldedTurnCount": 0, "kind": "scenario", "runID": "90410a3d129d", "scenarioID": "sc09_travel_plan", "startedAt": "2026-10-26T15:15:37.219768+00:00", "topic": "여행 계획", "turns": [{"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 211, "foldedTurnCount": 0, "index": 0, "inputTokens": 211, "modelMilliseconds": 308.1, "outputTokens": 13, "promptTurnCount": 4, "reply": "That sounds nice! What do you like to do there?", "userText": "Yes, I want to go to Jeju Island next month."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 243, "foldedTurnCount": 0, "index": 1, "inputTokens": 243, "modelMilliseconds": 330.3, "outputTokens": 14, "promptTurnCount": 6, "reply": "Three days sounds perfect! What are you two going to do?", "userText": "I will stay for three days with my sister."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 274, "foldedTurnCount": 0, "index": 2, "inputTokens": 274, "modelMilliseconds": 366.4, "outputTokens": 16, "promptTurnCount": 8, "reply": "You should see Halla Mountain and the beach. What do you think?", "userText": "What should I see in Jeju?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 309, "foldedTurnCount": 0, "index": 3, "inputTokens": 309, "modelMilliseconds": 313.0, "outputTokens": 13, "promptTurnCount": 10, "reply": "Good idea! Will you book for you and your sister?", "userText": "Thank you. I will book the hotel tonight."}]}
{"client": "qwen2.5:3b", "completed": true, "droppedTurnCount": 0, "durationMilliseconds": 1837.2, "errorMessage": null, "foldedTurnCount": 0, "kind": "scenario", "runID": "1193fa35cd79", "scenarioID": "sc10_pharmacy", "startedAt": "2026-10-26T15:15:38.537716+00:00", "topic": "병원과 약국", "turns": [{"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 209, "foldedTurnCount": 0, "index": 0, "inputTokens": 209, "modelMilliseconds": 374.2, "outputTokens": 16, "promptTurnCount": 4, "reply": "Oh no, that must feel uncomfortable. Have you tried taking any medicine?", "userText": "I have a headache and a sore throat."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 241, "foldedTurnCount": 0, "index": 1, "inputTokens": 241, "modelMilliseconds": 249.4, "outputTokens": 10, "promptTurnCount": 6, "reply": "Did you eat or drink anything different yesterday?", "userText": "I started feeling bad yesterday night."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 268, "foldedTurnCount": 0, "index": 2, "inputTokens": 268, "modelMilliseconds": 595.8, "outputTokens": 28, "promptTurnCount": 8, "reply": "It's best to take it on an empty stomach. But if you really can't wait, try to drink water instead of coffee.", "userText": "Can I take this medicine with coffee?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 316, "foldedTurnCount": 0, "index": 3, "inputTokens": 316, "modelMilliseconds": 617.7, "outputTokens": 29, "promptTurnCount": 10, "reply": "You should take it according to the instructions on the bottle. Usually, it's once or twice a day. How are you feeling now?", "userText": "Okay, thank you. How many times a day?"}]}
{"client": "qwen2.5:3b", "completed": true, "droppedTurnCount": 0, "durationMilliseconds": 1253.3, "errorMessage": null, "foldedTurnCount": 0, "kind": "scenario", "runID": "985755e9837f", "scenarioID": "sc11_phone_call", "startedAt": "2026-10-26T15:15:40.375064+00:00", "topic": "전화 통화", "turns": [{"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 213, "foldedTurnCount": 0, "index": 0, "inputTokens": 213, "modelMilliseconds": 351.5, "outputTokens": 13, "promptTurnCount": 4, "reply": "Not busy at all! How can I help you today?", "userText": "Hi Minji, it's Jina. Are you busy now?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 244, "foldedTurnCount": 0, "index": 1, "inputTokens": 244, "modelMilliseconds": 278.2, "outputTokens": 11, "promptTurnCount": 6, "reply": "That sounds good. When is the meeting planned?", "userText": "I call to ask about the meeting tomorrow."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 270, "foldedTurnCount": 0, "index": 2, "inputTokens": 270, "modelMilliseconds": 329.5, "outputTokens": 14, "promptTurnCount": 8, "reply": "The meeting starts at 10 AM. Is that okay?", "userText": "What time does it start?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 305, "foldedTurnCount": 0, "index": 3, "inputTokens": 305, "modelMilliseconds": 294.0, "outputTokens": 12, "promptTurnCount": 10, "reply": "Perfect! See you then. Have a great day!", "userText": "Okay, I will be there at nine. See you."}]}
{"client": "qwen2.5:3b", "completed": true, "droppedTurnCount": 0, "durationMilliseconds": 1611.7, "errorMessage": null, "foldedTurnCount": 0, "kind": "scenario", "runID": "4e0115fa2f5b", "scenarioID": "sc12_hotel_checkin", "startedAt": "2026-10-26T15:15:41.628412+00:00", "topic": "호텔 체크인", "turns": [{"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 214, "foldedTurnCount": 0, "index": 0, "inputTokens": 214, "modelMilliseconds": 303.9, "outputTokens": 12, "promptTurnCount": 4, "reply": "Great! Do you have your reservation details with you?", "userText": "Yes, I have a reservation for two nights."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 244, "foldedTurnCount": 0, "index": 1, "inputTokens": 244, "modelMilliseconds": 405.5, "outputTokens": 17, "promptTurnCount": 6, "reply": "Okay, Kim Jina. Got it. Should I proceed with your reservation?", "userText": "It is under the name Kim Jina."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 280, "foldedTurnCount": 0, "index": 2, "inputTokens": 280, "modelMilliseconds": 339.6, "outputTokens": 14, "promptTurnCount": 8, "reply": "Sure thing! Would you like a room on a high floor?", "userText": "Can I have a room on a high floor?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 309, "foldedTurnCount": 0, "index": 3, "inputTokens": 309, "modelMilliseconds": 562.6, "outputTokens": 24, "promptTurnCount": 10, "reply": "Breakfast is served from 7:00 to 9:00. Is that good for you?", "userText": "What time is the breakfast?"}]}
{"client": "qwen2.5:3b", "completed": true, "droppedTurnCount": 0, "durationMilliseconds": 1482.5, "errorMessage": null, "foldedTurnCount": 0, "kind": "scenario", "runID": "a4ca673d3632", "scenarioID": "sc13_public_transport", "startedAt": "2026-10-26T15:15:43.240269+00:00", "topic": "대중교통 이용", "turns": [{"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 215, "foldedTurnCount": 0, "index": 0, "inputTokens": 215, "modelMilliseconds": 327.2, "outputTokens": 13, "promptTurnCount": 4, "reply": "Okay, there it is. Swipe your card, please.", "userText": "Yes please. I want to go to City Hall."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 243, "foldedTurnCount": 0, "index": 1, "inputTokens": 243, "modelMilliseconds": 443.0, "outputTokens": 16, "promptTurnCount": 6, "reply": "You should take the Line 1. It goes right to City Hall.", "userText": "Which line should I take?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 274, "foldedTurnCount": 0, "index": 2, "inputTokens": 274, "modelMilliseconds": 344.0, "outputTokens": 15, "promptTurnCount": 8, "reply": "It's about four stops. Are you ready to swipe your card?", "userText": "How many stops is it?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 306, "foldedTurnCount": 0, "index": 3, "inputTokens": 306, "modelMilliseconds": 368.1, "outputTokens": 16, "promptTurnCount": 10, "reply": "You can transfer at the next stop. There's a transfer station there.", "userText": "Thank you. Where can I transfer?"}]}
{"client": "qwen2.5:3b", "completed": true, "droppedTurnCount": 0, "durationMilliseconds": 1359.2, "errorMessage": null, "foldedTurnCount": 0, "kind": "scenario", "runID": "d4b02de5a089", "scenarioID": "sc14_work_smalltalk", "startedAt": "2026-10-26T15:15:44.723184+00:00", "topic": "직장 잡담", "turns": [{"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 210, "foldedTurnCount": 0, "index": 0, "inputTokens": 210, "modelMilliseconds": 246.7, "outputTokens": 10, "promptTurnCount": 4, "reply": "That sounds nice! What did you wear?", "userText": "Yes, I went to my friend's wedding."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 240, "foldedTurnCount": 0, "index": 1, "inputTokens": 240, "modelMilliseconds": 283.1, "outputTokens": 12, "promptTurnCount": 6, "reply": "That's great! Do you like meeting new people?", "userText": "The food was very good and I meet many people."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 270, "foldedTurnCount": 0, "index": 2, "inputTokens": 270, "modelMilliseconds": 471.9, "outputTokens": 18, "promptTurnCount": 8, "reply": "I stayed at home and watched a movie. What did you do after the wedding?", "userText": "How about you? What did you do?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 308, "foldedTurnCount": 0, "index": 3, "inputTokens": 308, "modelMilliseconds": 357.3, "outputTokens": 14, "promptTurnCount": 10, "reply": "That would be nice! Where would you like to have lunch?", "userText": "That sounds fun. Let's have lunch together today."}]}
{"client": "qwen2.5:3b", "completed": true, "droppedTurnCount": 0, "durationMilliseconds": 1953.7, "errorMessage": null, "foldedTurnCount": 0, "kind": "scenario", "runID": "ad2bec16911a", "scenarioID": "sc15_movies_friends", "startedAt": "2026-10-26T15:15:46.082489+00:00", "topic": "친구와 영화 보기", "turns": [{"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 211, "foldedTurnCount": 0, "index": 0, "inputTokens": 211, "modelMilliseconds": 520.5, "outputTokens": 15, "promptTurnCount": 4, "reply": "I like thrillers. What kind of thrillers do you like?", "userText": "Sure. What movie do you want to see?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 248, "foldedTurnCount": 0, "index": 1, "inputTokens": 248, "modelMilliseconds": 401.9, "outputTokens": 13, "promptTurnCount": 6, "reply": "Ah, I see. What's your favorite comedy movie?", "userText": "I like comedy movies. The action is too loud for me."}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 277, "foldedTurnCount": 0, "index": 2, "inputTokens": 277, "modelMilliseconds": 496.9, "outputTokens": 17, "promptTurnCount": 8, "reply": "I'm not sure about the start time. What time works best for you?", "userText": "What time is the movie start?"}, {"didDropSummary": false, "didTruncateUserText": false, "droppedTurnCount": 0, "estimatedPromptTokens": 314, "foldedTurnCount": 0, "index": 3, "inputTokens": 314, "modelMilliseconds": 534.2, "outputTokens": 19, "promptTurnCount": 10, "reply": "Great! See you at seven then. Do you have any snacks you want to bring?", "userText": "Okay, let's meet at the theater at seven."}]}
